# Copy to .env for local development. Never commit real secrets.

# Postgres connection string. On Railway, use the Postgres plugin variable.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# Required in production. Auth.js / NextAuth session signing secret.
NEXTAUTH_SECRET=""

# Public origin of this app, no trailing slash. Example: https://your-app.up.railway.app
NEXTAUTH_URL="http://localhost:3000"

# Optional. Hook Lab transcription, and AI Editor clip reading. When unset, AI Editor still edits from the picture cuts and any speech it can read locally.
OPENAI_API_KEY=""
# Optional. AI Editor vision uses this model when set. Otherwise it tries gpt-4o, then gpt-4o-mini.
OPENAI_MODEL=""

# Optional. Jamendo client id for legal music search in AI Editor. When unset, search asks the user to upload audio instead.
JAMENDO_CLIENT_ID=""

# Optional. Comma-separated CODE:plan pairs for plan testing. plan is starter, growth, pro, business, or agency.
PROMO_CODES=""

# Required only for credit top-ups and subscriptions.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Required only for verification and team invite email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Uniq <noreply@yourdomain.com>"
