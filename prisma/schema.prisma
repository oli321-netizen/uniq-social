generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  emailVerified         Boolean  @default(false)
  credits               Int      @default(5)
  plan                  String   @default("free")
  referralCode          String?  @unique
  stripeCustomerId      String?  @unique
  stripeSubscriptionId  String?  @unique
  stripePriceId         String?
  subscriptionStatus    String?
  currentPeriodEnd      DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  teamId                String?
  teamRole              String?    // "owner" | "member"
  team                  Team?      @relation(fields: [teamId], references: [id])
  apiKeys               ApiKey[]
  passwordResets        PasswordReset[]
  transactions          Transaction[]
  emailVerifications    EmailVerification[]
  processingJobs        ProcessingJob[]
  processingHistory     ProcessingHistory[]
  referralsGiven        Referral[] @relation("ReferralsGiven")
  referredBy            Referral?  @relation("ReferredBy")
  creators              Creator[]
  hooks                 Hook[]
  videoSources          VideoSource[]
  creativeVariants      CreativeVariant[]
  presets               Preset[]
  integration           IntegrationSetting?
  activity              ActivityLog[]
  scheduledPushes       ScheduledPush[]
  captions              Caption[]
  notifications         Notification[]
  notificationSetting   NotificationSetting?
}

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(uuid())
  name      String
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsed  DateTime?
  createdAt DateTime @default(now())
}

model Team {
  id          String       @id @default(uuid())
  name        String
  credits     Int          @default(0)
  ownerId     String
  members     User[]
  invites     TeamInvite[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamInvite {
  id        String   @id @default(uuid())
  email     String
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // "pending" | "accepted" | "declined"
  credits   Int      @default(0)         // credits owner assigns to the invited user
  createdAt DateTime @default(now())

  @@unique([email, teamId])
}

model PromoCode {
  id           String   @id @default(uuid())
  code         String   @unique
  bonusCredits Int
  maxUses      Int      @default(100)
  uses         Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String
  credits     Int      @default(0)
  amount      Int      @default(0)
  currency    String   @default("gbp")
  createdAt   DateTime @default(now())
}

model EmailVerification {
  id           String   @id @default(uuid())
  token        String
  email        String   @default("")
  passwordHash String?
  referralCode String?
  promoCode    String?
  inviteId     String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model ProcessingJob {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  copies     Int      @default(1)
  status     String   @default("completed")
  createdAt  DateTime @default(now())
}

model ProcessingHistory {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceHash      String   // SHA-256 of source video to identify same video across uploads
  fileName        String
  // All random parameters used for this copy
  startTrim       Float
  zoomPct         Float
  cutPoints       String   // JSON array of cut positions
  mirror          Boolean
  grainEnabled    Boolean
  grainIntensity  Float
  sharpenEnabled  Boolean
  sharpenAmount   Float
  metadataProfile String
  // Fingerprint-breaking params
  speedFactor     Float    @default(1.0)
  brightnessDelta Float    @default(0.0)
  contrastDelta   Float    @default(1.0)
  saturationDelta Float    @default(1.0)
  crfValue        Int      @default(18)
  gopSize         Int      @default(48)
  hueRotation     Float    @default(0.0)
  gammaShift      Float    @default(1.0)
  cropOffsetX     Int      @default(0)
  cropOffsetY     Int      @default(0)
  introFadeDuration Float  @default(0.0)
  createdAt       DateTime @default(now())

  @@index([userId, sourceHash])
}

model Referral {
  id          String   @id @default(uuid())
  code        String   @unique
  referrerId  String
  referrer    User     @relation("ReferralsGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String?  @unique
  referred    User?    @relation("ReferredBy", fields: [referredId], references: [id])
  credited    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Creator {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  niche         String             @default("")
  toneNotes     String             @default("")
  handle        String             @default("")
  toneChips     String             @default("[]")
  slangPhrases  String             @default("[]")
  avoidWords    String             @default("[]")
  examplePosts  String             @default("[]")
  voiceStrength Int                @default(60)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  hooks         Hook[]
  presets       Preset[]
  variants      CreativeVariant[]
  captions      Caption[]

  @@index([userId])
}

model Hook {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId      String?
  creator        Creator?           @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  text           String
  topic          String             @default("")
  score          Int                @default(0)
  sparkline      String             @default("[]")
  favourite      Boolean            @default(false)
  views          Int                @default(0)
  watchTimeSec   Float              @default(0)
  hookRate       Float              @default(0)
  shareRate      Float              @default(0)
  shares         Int                @default(0)
  saves          Int                @default(0)
  follows        Int                @default(0)
  loggedResults  Int                @default(0)
  generationMode String             @default("mock")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  variants       CreativeVariant[]

  @@index([userId, creatorId])
}

model VideoSource {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  bytes      Int                @default(0)
  storageKey String
  createdAt  DateTime           @default(now())
  variants   CreativeVariant[]

  @@index([userId])
}

model CreativeVariant {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId      String?
  creator        Creator?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  hookId         String?
  hook           Hook?           @relation(fields: [hookId], references: [id], onDelete: SetNull)
  sourceId       String?
  source         VideoSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  name           String
  testsDimension String
  status         String          @default("pending")
  progress       Int             @default(0)
  durationSec    Float           @default(0)
  hookText       String          @default("")
  favourite      Boolean         @default(false)
  sortOrder      Int             @default(0)
  error          String?
  paramsJson     String          @default("{}")
  storageKey     String?
  batchKey       String          @default("")
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  results        VariantResult[]
  pushes         ScheduledPush[]
  captions       Caption[]

  @@index([userId, deletedAt])
  @@index([userId, batchKey])
}

model Caption {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId String?
  creator   Creator?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  variantId String?
  variant   CreativeVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  topic     String           @default("")
  text      String
  createdAt DateTime         @default(now())

  @@index([userId, creatorId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String    @default("")
  href      String    @default("/")
  readAt    DateTime?
  ref       String    @default("")
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, ref])
}

model NotificationSetting {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)
}

model VariantResult {
  id          String           @id @default(uuid())
  userId      String
  variantId   String
  variant     CreativeVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  platform    String           @default("manual")
  postedAt    DateTime?
  views       Int              @default(0)
  viewRate3s  Float            @default(0)
  avgWatchSec Float            @default(0)
  shares      Int              @default(0)
  saves       Int              @default(0)
  follows     Int              @default(0)
  source      String           @default("manual")
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([variantId])
}

model Preset {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId  String?
  creator    Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  name       String
  configJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model IntegrationSetting {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postizApiKey String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ScheduledPush {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   CreativeVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  caption   String           @default("")
  status    String           @default("recorded")
  detail    String           @default("")
  createdAt DateTime         @default(now())

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ref       String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
