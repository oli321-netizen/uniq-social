generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  emailVerified         Boolean  @default(false)
  credits               Int      @default(5)
  plan                  String   @default("free")
  referralCode          String?  @unique
  stripeCustomerId      String?  @unique
  stripeSubscriptionId  String?  @unique
  stripePriceId         String?
  subscriptionStatus    String?
  currentPeriodEnd      DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  teamId                String?
  teamRole              String?    // "owner" | "member"
  team                  Team?      @relation(fields: [teamId], references: [id])
  apiKeys               ApiKey[]
  passwordResets        PasswordReset[]
  transactions          Transaction[]
  emailVerifications    EmailVerification[]
  processingJobs        ProcessingJob[]
  referralsGiven        Referral[] @relation("ReferralsGiven")
  referredBy            Referral?  @relation("ReferredBy")
}

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(uuid())
  name      String
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsed  DateTime?
  createdAt DateTime @default(now())
}

model Team {
  id          String       @id @default(uuid())
  name        String
  credits     Int          @default(0)
  ownerId     String
  members     User[]
  invites     TeamInvite[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamInvite {
  id        String   @id @default(uuid())
  email     String
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // "pending" | "accepted" | "declined"
  credits   Int      @default(0)         // credits owner assigns to the invited user
  createdAt DateTime @default(now())

  @@unique([email, teamId])
}

model PromoCode {
  id           String   @id @default(uuid())
  code         String   @unique
  bonusCredits Int
  maxUses      Int      @default(100)
  uses         Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String
  credits     Int      @default(0)
  amount      Int      @default(0)
  currency    String   @default("gbp")
  createdAt   DateTime @default(now())
}

model EmailVerification {
  id           String   @id @default(uuid())
  token        String
  email        String   @default("")
  passwordHash String?
  referralCode String?
  promoCode    String?
  inviteId     String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model ProcessingJob {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  copies     Int      @default(1)
  status     String   @default("completed")
  createdAt  DateTime @default(now())
}

model Referral {
  id          String   @id @default(uuid())
  code        String   @unique
  referrerId  String
  referrer    User     @relation("ReferralsGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String?  @unique
  referred    User?    @relation("ReferredBy", fields: [referredId], references: [id])
  credited    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
